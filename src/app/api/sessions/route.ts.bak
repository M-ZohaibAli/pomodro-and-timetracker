import { db } from "@/db";
import { focusSessionsTable } from "@/db/schema";
import { desc } from "drizzle-orm";
import { NextResponse } from "next/server";

export const dynamic = "force-dynamic";

export async function GET() {
  try {
    if (!db) return NextResponse.json({ success: false, sessions: [] });
    const sessions = await db
      .select()
      .from(focusSessionsTable)
      .orderBy(desc(focusSessionsTable.startedAt))
      .limit(200);
    return NextResponse.json({ success: true, sessions });
  } catch (err) {
    return NextResponse.json({ success: false, error: String(err) }, { status: 500 });
  }
}

export async function POST(req: Request) {
  try {
    if (!db) return NextResponse.json({ success: false, error: "No database configured" });
    const body = await req.json();
    const {
      id,
      taskId,
      taskTitle,
      project,
      startedAt,
      endedAt,
      durationSeconds,
      sessionType,
      completed,
      interrupted,
      pauseDurationSeconds,
      isManual,
      notes,
    } = body;

    if (!id || !startedAt || !endedAt || durationSeconds === undefined) {
      return NextResponse.json(
        { success: false, error: "Missing required session parameters" },
        { status: 400 }
      );
    }

    await db.insert(focusSessionsTable).values({
      id,
      taskId: taskId || null,
      taskTitle: taskTitle || "Focus Session",
      project: project || "General",
      startedAt: new Date(startedAt),
      endedAt: new Date(endedAt),
      durationSeconds: Number(durationSeconds),
      sessionType: sessionType || "focus",
      completed: Boolean(completed),
      interrupted: Boolean(interrupted),
      pauseDurationSeconds: Number(pauseDurationSeconds || 0),
      isManual: Boolean(isManual),
      notes: notes || null,
    });

    return NextResponse.json({ success: true });
  } catch (err) {
    return NextResponse.json({ success: false, error: String(err) }, { status: 500 });
  }
}
